# Markaziy database (Supabase / Neon / Render Postgres) ulanish manzili.
# Shu bo'lmasa, ma'lumotlar har bir kompyuterda alohida qoladi (yoki serverdagi vaqtinchalik faylda).
DATABASE_URL="postgresql://USER:PAROL@HOST:5432/DBNOMI"

# Groq AI kaliti (AI murabbiy uchun). Kodga YOZMANG, faqat shu yerda / Render'da kiriting.
GROQ_API_KEY=""

# GEMINI_API_KEY: ixtiyoriy (AI Studio avtomatik beradi)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
ADMIN_SECRET=""

